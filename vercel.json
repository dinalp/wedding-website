{
  "crons": [
    {
      "path": "/api/cron/flights",
      "schedule": "0 20 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/rsvp/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
